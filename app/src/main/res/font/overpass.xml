<?xml version="1.0" encoding="utf-8"?>
<!-- Overpass: open-source (OFL) family based on Highway Gothic road-sign lettering.
     Both android: and app: attributes so it works below API 26. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/overpass_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/overpass_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/overpass_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/overpass_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        android:font="@font/overpass_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/overpass_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
    <font
        android:font="@font/overpass_extrabold"
        android:fontStyle="normal"
        android:fontWeight="800"
        app:font="@font/overpass_extrabold"
        app:fontStyle="normal"
        app:fontWeight="800" />
</font-family>
