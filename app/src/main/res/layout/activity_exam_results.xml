<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fitsSystemWindows="true"
    tools:context=".ExamResultsActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Exam results"
                android:textAppearance="@style/TextAppearance.Lto.Title.OnNavy"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/tvCategoryName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Non-Professional"
                android:textAppearance="@style/TextAppearance.Lto.Body.OnNavy" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Lto.Card.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Score ring: green when passed, red when failed (set in code) -->
                    <FrameLayout
                        android:layout_width="168dp"
                        android:layout_height="168dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/scoreProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            app:indicatorSize="168dp"
                            app:trackThickness="14dp" />

                        <TextView
                            android:id="@+id/tvScorePercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="0%"
                            android:textAppearance="@style/TextAppearance.Lto.Display"
                            android:textColor="@color/navy_900" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvPassFail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:paddingStart="20dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="6dp"
                        android:text="Passed"
                        android:textAppearance="@style/TextAppearance.Lto.Label"
                        android:textColor="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="You need 80% to pass."
                        android:textAppearance="@style/TextAppearance.Lto.Caption" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="20dp"
                        android:background="@color/cream_200" />

                    <!-- Stats: Correct / Incorrect / Skipped -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <LinearLayout style="@style/ResultStat">
                            <TextView
                                android:id="@+id/tvCorrectCount"
                                style="@style/ResultStatValue"
                                android:textColor="@color/go_green" />
                            <TextView style="@style/ResultStatLabel" android:text="Correct" />
                        </LinearLayout>

                        <LinearLayout style="@style/ResultStat">
                            <TextView
                                android:id="@+id/tvIncorrectCount"
                                style="@style/ResultStatValue"
                                android:textColor="@color/stop_red" />
                            <TextView style="@style/ResultStatLabel" android:text="Incorrect" />
                        </LinearLayout>

                        <LinearLayout style="@style/ResultStat">
                            <TextView
                                android:id="@+id/tvUnansweredCount"
                                style="@style/ResultStatValue" />
                            <TextView style="@style/ResultStatLabel" android:text="Skipped" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReviewAnswers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Review answers" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBackToHome"
                        style="@style/Widget.Lto.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Back to home" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
