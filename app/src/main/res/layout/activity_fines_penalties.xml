<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".FinesPenaltiesActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Matches the Road Signs screen: no title bar / back arrow,
                 just the logo, then straight into the card. No bottom nav either. -->

            <!-- TODO: replace with the LTO logo. Put your image in res/drawable/
                 and change android:src below to @drawable/your_file_name -->
            <ImageView
                android:id="@+id/imgLogoMain"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:src="@drawable/bg_placeholder"
                android:contentDescription="LTO logo" />

            <!-- VIOLATION / FINE CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                app:cardBackgroundColor="@color/cream"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Progress counter, right-aligned -->
                    <TextView
                        android:id="@+id/tvProgressCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:gravity="end"
                        android:text="1 of 20"
                        android:textColor="@color/text_dark"
                        android:textSize="9sp" />

                    <!-- TODO: replace with a fines/penalty icon (e.g. a ticket or peso-sign icon).
                         Put the image in res/drawable/ and reference it per-item in Kotlin. -->
                    <ImageView
                        android:id="@+id/imgViolationIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="4dp"
                        android:src="@drawable/bg_placeholder"
                        android:contentDescription="Violation icon" />

                    <!-- Violation name -->
                    <TextView
                        android:id="@+id/tvViolationName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:text="Driving Without a License"
                        android:textColor="@color/text_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Fine amount, highlighted like the Review screen's answer box -->
                    <TextView
                        android:id="@+id/tvFineAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_selected_answer"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="10dp"
                        android:text="₱3,000 (1st offense)"
                        android:textColor="@color/navy_top"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Short description of the violation -->
                    <TextView
                        android:id="@+id/tvViolationDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:text="Operating a motor vehicle on a public road without a valid driver's license issued by the LTO."
                        android:textColor="@color/text_dark"
                        android:textSize="10sp" />

                    <!-- BOTTOM ROW: End / Next -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnEnd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="6dp"
                            android:fontFamily="serif"
                            android:text="End"
                            android:textColor="@color/text_dark"
                            android:textSize="9sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/btnNext"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_next_button"
                            android:fontFamily="serif"
                            android:paddingStart="20dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="20dp"
                            android:paddingBottom="8dp"
                            android:text="Next"
                            android:textColor="@color/text_dark"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>