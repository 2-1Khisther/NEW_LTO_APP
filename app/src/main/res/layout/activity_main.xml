<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".MainActivity">

    <ScrollView
        android:id="@+id/scrollDashboard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- HEADER: logo, greeting, language -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgLogoMain"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Lto.Circle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/lto_logo"
                    android:contentDescription="LTO logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvWelcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hi there"
                        android:textAppearance="@style/TextAppearance.Lto.Title.OnNavy" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pick a category or take a mock exam."
                        android:textAppearance="@style/TextAppearance.Lto.Body.OnNavy"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnTranslate"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="12dp"
                    android:src="@drawable/ic_translate"
                    app:tint="@color/white"
                    android:contentDescription="Change language" />
            </LinearLayout>

            <!-- SCORE HERO: one card holds the score and mock exam progress -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Lto.Card.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Overall score"
                                android:textAppearance="@style/TextAppearance.Lto.Label"
                                android:textColor="@color/ink_muted" />

                            <TextView
                                android:id="@+id/tvOverallScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="83%"
                                android:textAppearance="@style/TextAppearance.Lto.Display"
                                android:textColor="@color/navy_900" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="You need 80% to pass."
                                android:textAppearance="@style/TextAppearance.Lto.Caption" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/donutScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:progress="83"
                            android:importantForAccessibility="no"
                            app:indicatorSize="88dp"
                            app:trackThickness="10dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/cream_200" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mock exams completed"
                            android:textAppearance="@style/TextAppearance.Lto.Label" />

                        <TextView
                            android:id="@+id/tvMockCompleted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="70%"
                            android:textAppearance="@style/TextAppearance.Lto.Label"
                            android:textColor="@color/navy_900" />
                    </LinearLayout>

                    <com.example.new_lto_app.LaneProgressView
                        android:id="@+id/laneMock"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="10dp"
                        app:laneTrackColor="@color/navy_700" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Review by category"
                android:textAppearance="@style/TextAppearance.Lto.Heading"
                android:textColor="@color/white" />

            <!-- CATEGORY GRID (2 x 2) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNonPro"
                    style="@style/CategoryTile"
                    android:layout_marginEnd="6dp">
                    <LinearLayout style="@style/CategoryInner">
                        <ImageView style="@style/CategoryIcon" android:src="@drawable/ic_badge" />
                        <TextView style="@style/CategoryLabel" android:text="Non-&#8203;professional" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPro"
                    style="@style/CategoryTile"
                    android:layout_marginStart="6dp">
                    <LinearLayout style="@style/CategoryInner">
                        <ImageView style="@style/CategoryIcon" android:src="@drawable/ic_local_shipping" />
                        <TextView style="@style/CategoryLabel" android:text="Professional" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRoadSigns"
                    style="@style/CategoryTile"
                    android:layout_marginEnd="6dp">
                    <LinearLayout style="@style/CategoryInner">
                        <ImageView style="@style/CategoryIcon" android:src="@drawable/ic_traffic" />
                        <TextView style="@style/CategoryLabel" android:text="Road signs" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFines"
                    style="@style/CategoryTile"
                    android:layout_marginStart="6dp">
                    <LinearLayout style="@style/CategoryInner">
                        <ImageView style="@style/CategoryIcon" android:src="@drawable/ic_receipt_long" />
                        <TextView style="@style/CategoryLabel" android:text="Fines and penalties" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAV (styled by Widget.Lto.BottomNav in the theme) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
