<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One plain text field (Register). Login uses Widget.Lto.TextInput instead. -->
    <style name="AuthInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Lto.Body</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_muted</item>
    </style>

    <!-- Main submit button on a TextView (Register). Login uses MaterialButton. -->
    <style name="AuthButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/bg_next_button</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">14dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Lto.Button</item>
        <item name="android:textColor">@color/navy_900</item>
    </style>
</resources>
