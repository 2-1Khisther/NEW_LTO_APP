<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dashboard category tile: icon top-left, label bottom-left -->
    <style name="CategoryTile" parent="Widget.Lto.Card.Tile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">132dp</item>
        <item name="android:layout_weight">1</item>
    </style>
    <style name="CategoryInner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>
    <!-- Decorative: the label below names the tile -->
    <style name="CategoryIcon">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_icon_tile</item>
        <item name="android:padding">12dp</item>
        <item name="tint">@color/navy_900</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="CategoryLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">bottom|start</item>
        <item name="android:textAppearance">@style/TextAppearance.Lto.Heading</item>
        <item name="android:textColor">@color/navy_900</item>
        <item name="android:textSize">16sp</item>
        <!-- Break "Non-professional" at its hyphen, never mid-word -->
        <item name="android:hyphenationFrequency">none</item>
        <item name="android:breakStrategy">simple</item>
    </style>
</resources>
