<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One answer choice: navy rounded box, white text, radio circle on the right -->
    <style name="ExamOption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_option_navy</item>
        <item name="android:button">@null</item>
        <item name="android:drawableEnd">@drawable/radio_selector</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">9sp</item>
    </style>
</resources>