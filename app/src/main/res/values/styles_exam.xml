<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Answer options use Widget.Lto.ExamOption (styles_components.xml) -->

    <!-- One column of the Results stats row -->
    <style name="ResultStat">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="ResultStatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">0</item>
        <item name="android:textAppearance">@style/TextAppearance.Lto.Title</item>
        <item name="android:textSize">26sp</item>
    </style>
    <style name="ResultStatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Lto.Caption</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
